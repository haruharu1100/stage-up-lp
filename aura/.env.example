# === AURA 環境変数（号機ごとに差し替え）===

# 号機の切替: gacha | sneaker | hub
NEXT_PUBLIC_BRAND=gacha

# 動作モード: test の間は外部に一切出ない（P2まで test 固定）
NEXT_PUBLIC_AURA_MODE=test
AURA_MODE=test

# --- 以下は P1 以降で使用（P0では不要）---

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# トークン暗号化用（32バイト以上）
TOKEN_ENCRYPTION_KEY=

# X 認証方式の選択。未指定なら「4点キーが揃っていれば oauth1、無ければ oauth2」を自動判定。
#   oauth1 = 既存のごろごろ/キクソラの4点キー方式（ブラウザ認可が不要・推奨）
#   oauth2 = X Developer Portalで発行する Client ID/Secret 方式（連携許可ボタンでつなぐ）
X_AUTH_MODE=

# --- 方式A: OAuth 1.0a（4点キー）。号機のアカウントの鍵をそのまま入れる ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- 方式B: OAuth 2.0（PKCE）。号機ごとに別アプリを作成して発行 ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Anthropic
ANTHROPIC_API_KEY=

# LINE Messaging API（gacha / sneaker のみ）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
