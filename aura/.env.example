# === AURA 環境変数（号機ごとに差し替え）===

# 号機の切替: gacha | sneaker | hub
NEXT_PUBLIC_BRAND=gacha

# 動作モード: test の間は外部に一切出ない（P2まで test 固定）
NEXT_PUBLIC_AURA_MODE=test
AURA_MODE=test

# --- 以下は P1 以降で使用（P0では不要）---

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# トークン暗号化用（32バイト以上）
TOKEN_ENCRYPTION_KEY=

# X API v2（Basicプラン / 号機ごとに別アプリ）
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Anthropic
ANTHROPIC_API_KEY=

# LINE Messaging API（gacha / sneaker のみ）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
