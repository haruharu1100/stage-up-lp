# AI Commerce OS — Phase 1
# Phase 1 は Research / Calculation / Simulation のみ。外部への送信は一切行わない。

DATABASE_URL=file:data/commerce.db

# --- 自動化モード（Phase 1 では変更しない） ---
COMMERCE_AUTO_MODE=SAFE
SANDBOX=true
SHADOW_MODE=true

AUTO_RESEARCH=true
AUTO_BUY=false
AUTO_LISTING=false
AUTO_REPRICE=false
AUTO_ORDER_PROCESSING=false
AUTO_REORDER=false

# Phase 1 では AI を呼ばない。候補の印を付けて件数を数えるだけ。
AI_ENABLED=false

# --- Keepa（Phase 3.10・読み取り専用） ---
# ★値はここ（.env.example）に絶対に書かない。書くのは .env の方だけ。
#   .env は .gitignore 済みなので、Git にも公開先にも上がらない。
#   このシステムはキーの値を画面にも記録にも出さない（名前だけを扱う）。
#   1回の実行で取れるのは1件だけで、この設定で増やすことはできない。
KEEPA_API_KEY=
