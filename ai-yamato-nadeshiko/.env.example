# このファイルをコピーして .env を作る。.env は絶対にコミットしない。
# ★どれも「まだ無くても Phase 1 の作業は進む」。無い間は該当機能だけが止まり、人へ通知が出る。

# --- DB（省略可。省略すると ./data/yamato.db を使う） ---
# DATABASE_URL=file:./data/yamato.db
# DATABASE_AUTH_TOKEN=

# --- X（実績の取得に使う。投稿には使わない） ---
# 自分の投稿の非公開指標（リンククリック数・プロフィールクリック数）は
# ユーザーコンテキストのアクセストークンでしか取れない。
# 未設定なら npm run metrics:daily は取得せずに人へ通知して終わる。
X_USER_ACCESS_TOKEN=

# --- 自動実行の可否 ---
# ★現時点では、この4つを true にしても何も起きない。
#   外部へ副作用を出すコード（投稿・申請送信・案件切替・公開）を、そもそも1行も書いていないため。
#   スイッチだけ先に置いて「切ってあるつもり」になるのが一番危ないので、ここに事実を書いておく。
#   実装するときは、この値を読むだけでなく「人間の承認記録」も必要にする（二重ロック）。
AUTO_X_POST=false
AUTO_AFFILIATE_APPLY=false
AUTO_OFFER_CHANGE=false
AUTO_CONTENT_PUBLISH=false
