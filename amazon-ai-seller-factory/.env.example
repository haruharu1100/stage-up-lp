# ============================================================
#  Amazon AI Seller Factory  環境変数
#  .env.example を .env にコピーして埋める。空でもモックで動く。
# ============================================================

# --- 安全スイッチ（最重要）------------------------------------
# true にしない限り Amazon へ本番出品しない（下書きまで）
AMAZON_AUTO_PUBLISH=false
# true = 外部APIを一切叩かない完全オフライン（モックのみ）
OFFLINE_MODE=false

# --- AI（文章）------------------------------------------------
# どちらか片方あればOK。両方無ければモック文章で動く
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
# llm プロバイダ: auto | anthropic | openai | mock
LLM_PROVIDER=auto

# --- AI（画像）------------------------------------------------
# OPENAI_API_KEY を使う。検証済みレシピ: gpt-image-2 / quality=medium
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# image プロバイダ: auto | openai | mock
IMAGE_PROVIDER=auto

# --- AI（動画）------------------------------------------------
# 動画は「構成・絵コンテ・プロンプト」まで生成。実レンダリングは Adapter 差し替え
# video プロバイダ: mock | fal | runway （fal/runway は鍵が入り次第）
VIDEO_PROVIDER=mock
FAL_KEY=
RUNWAY_API_KEY=

# --- 市場データ（スクレイピングはしない）----------------------
# market プロバイダ: auto | keepa | csv | manual | mock
MARKET_PROVIDER=auto
KEEPA_API_KEY=
# Amazon Product Advertising API（審査通過後に有効化）
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=

# --- レビュー本文（正規ソースのみ）----------------------------
# review プロバイダ: auto | csv | mock  （csv = data/reviews/<ASIN>.csv）
REVIEW_PROVIDER=auto

# --- Amazon SP-API -------------------------------------------
# amazon プロバイダ: auto | spapi | mock
AMAZON_PROVIDER=auto
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_SELLER_ID=
SPAPI_MARKETPLACE_ID=A1VC38T7YXB528
SPAPI_ENDPOINT=https://sellingpartnerapi-fe.amazon.com
SPAPI_LWA_ENDPOINT=https://api.amazon.com/auth/o2/token

# --- ストレージ ------------------------------------------------
# storage プロバイダ: local | s3
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- DB --------------------------------------------------------
# 既定はローカルSQLite。Postgres/Turso へ移す時はここを変える
DATABASE_URL=file:./data/factory.db

# --- 利益計算の前提（概算・必ず自分のアカウントの実数で上書き）--
ASSUMED_AD_COST_RATE=0.10
ASSUMED_RETURN_RATE=0.02
IMPORT_SHIPPING_RATE=0.08

# --- 商品発掘（A/B/C/D判定）の基準 ------------------------------
# ここを満たすと「A＝今すぐ仕入れ」。厳しくすると件数が減り、緩めると増える
MIN_PROFIT_RATE=0.15
MIN_PROFIT_JPY=500
MIN_ROI=0.30
# 出品者がこの人数を超えたら値下げ競争になるので C（競合が減ったら）に落とす
MAX_SELLER_COUNT=12
# Amazon本体が売っている商品は相乗りを避ける
AVOID_AMAZON_SELLING=true

# --- 仕入れ・FBA切替 --------------------------------------------
# 初回の試し仕入れに出してよい現金の上限
FIRST_BUY_BUDGET_JPY=30000
# 週に何個売れたらFBAに切り替えるか
FBA_SWITCH_UNITS_PER_WEEK=3
# 仕入リードタイムに足す自分の作業日数（出荷遅延を防ぐ余裕）
HANDLING_BUFFER_DAYS=3

# 海外仕入の円換算レート（実勢に合わせて更新する）
USD_JPY=155
CNY_JPY=21

# --- 自社ブランド（OEM）------------------------------------------
# 商標登録済みの自社ブランド名をカンマ区切りで。ここに一致した商品だけ
# 「新規ページを作ってよい」と判定される（重複出品違反の防止）
OWN_BRANDS=

# --- 広告 --------------------------------------------------------
# true にすると広告の自動最適化が動く。既定は false（人が承認する）
AD_AUTO_OPTIMIZE=false


# ============================================================
#  ① リサーチツール（安い仕入先 → Amazonで売れている同一商品 を自動で探す）
# ============================================================

# --- 安全スイッチ ---------------------------------------------
# ★方針：調査と分析は自動でよい。お金が動く行為だけは必ず人が承認する。
#
# 自動発注。true にすると research スクリプトもスケジューラも起動を拒否する
AUTO_PURCHASE=false
# AIが仕入候補を「承認」することは無い。承認は必ず人がやる
RESEARCH_AUTO_APPROVE=false
# 毎日の自動リサーチ（探して並べるだけ。仕入も出品も価格変更も起きない）
# ここだけ true でよい。実際に時間どおり動かすには npm run scheduler:loop か cron が必要
RESEARCH_AUTO_RUN=true

# --- 仕入先（SupplierProvider）---------------------------------
# 使う仕入先をカンマ区切りで。
#   auto = CSVがあればCSV → スプレッドシート設定があればそれ → 鍵があればAPI → 無ければサンプル
# 指定できるもの: auto | csv | sheets | aliexpress | alibaba | 1688 | sample
SUPPLIER_PROVIDERS=auto

# ★★ 一番おすすめ：Googleスプレッドシート（無料・審査なし・契約なし）★★
#   1回だけ設定すれば、以後は毎回そこを自動で読みます（CSVを毎回置く手間なし）。
#   やること：
#     1. Googleスプレッドシートに仕入先の商品一覧を作る
#        （1行目が見出し。見出しの書き方は samples/supplier_listings.csv と同じでOK。
#         supplier_name / product_name / product_url / image_url / price / currency /
#         minimum_order_quantity / stock / brand / model_number / jan / size / weight /
#         color / shipping_cost / updated_at などを用意。取れない列は空でよい＝不明扱い）
#     2. 右上「共有」→「リンクを知っている全員」→「閲覧者」にする
#     3. ブラウザのURLをそのまま下の SUPPLIER_SHEET_URL に貼る
SUPPLIER_SHEET_URL=
# タブが複数ある時だけ、使いたいタブの gid（URLの #gid=… の数字）
SUPPLIER_SHEET_GID=
# 共有リンクではなく「シートID」だけ分かっている場合はこちらでも可
SUPPLIER_SHEET_ID=
# 非公開のまま読みたい場合だけ（Google Sheets API v4 のAPIキー）。空でよい
GOOGLE_SHEETS_API_KEY=
SUPPLIER_SHEET_RANGE=

# ★CSV仕入先は data/supplier_listings.csv に置くだけで即・実データになる
#   列の見本: samples/supplier_listings.csv （毎回自分で置き直す必要があります）

# ==============================================================
#  ★★AliExpress（2026-08-20 時点で「本命」）
#     公式・無料。日本の個人でも申請できます。
#     ここが埋まると、初めて「システムが自分で仕入先を探す」が本物になります。
# ==============================================================
#   ※ ALIEXPRESS_API_ENDPOINT は空でよい（既定 https://api-sg.aliexpress.com/sync）
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_API_ENDPOINT=

# --- ここまでの2つ（KEY と SECRET）だけで動く枠 ------------------
#   アフィリエイト系API（aliexpress.affiliate.product.query）は
#   ★アクセストークン不要。＝いちばん早くLIVEにできる入口。
#   ただし本来は販促のための枠なので、仕入判断だけに大量に使い続けると
#   アカウント停止の可能性は残ります（規約に明示の禁止条項は確認できませんでした）。
ALIEXPRESS_TRACKING_ID=
# 送り先の国／通貨／言語（日本向けに固定）
ALIEXPRESS_SHIP_TO=JP
ALIEXPRESS_CURRENCY=JPY
ALIEXPRESS_LANGUAGE=ja
# 呼び出しの間隔（ミリ秒）。叩きすぎで止められないための栓
ALIEXPRESS_AFFILIATE_MIN_INTERVAL_MS=400

# --- アクセストークンが要る枠（Dropshipping API）-----------------
#   ★MOQ・在庫・実重量・実送料・公式の画像検索は、こちらでしか取れません。
#     アフィリエイト枠だけだと、これらは全部 UNKNOWN のままになります。
#     取得手順は 事業Vault/Amazon AI Seller OS/13_AliExpress申請手順.md
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=
# 1回の探索で「詳細（MOQ・在庫・重量）」まで取りに行く上限件数
ALIEXPRESS_DETAIL_LIMIT=20
# 画像検索へ送る画像の上限サイズ（KB）。これを超える画像は送らない
ALIEXPRESS_IMAGE_MAX_KB=100

# ==============================================================
#  Alibaba.com（ICBU）公式API
#    ★2026-08-20 監査の結論：
#      「買い手が全カタログをキーワードで検索するAPI」は公式に存在しません。
#      使えるのは distribution（配信）系だけで、これは
#      「自分に割り当てられた商品プールを1ページずつ並べる」ものです。
#      → Amazonで売れている物を狙って探す用途には使えません。
#    そのため、下の ENABLED を人が true にしない限り接続しません。
# ==============================================================
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
# 配信プールを実際に割り当ててもらえた人だけ true にしてください
ALIBABA_DISTRIBUTION_ENABLED=false
ALIBABA_CURRENCY=USD

# 1688 … 日本の個人が規約を守って使える正規の入口を確認できていないため接続しません
#   （代行業者からの提供データを上のスプレッドシートで受け取る方が確実です）

# ==============================================================
#  ★仕入先の自動探索（Supplier Discovery）
#    「商品一覧を人が作らなくても、システムが自分で安い商品を探す」機能。
#    ここが空だと、システムは受け取り口（スプレッドシート/CSV）しか読めません。
# ==============================================================

# 使う探索先をカンマ区切りで（aliexpress_affiliate,aliexpress,alibaba,yahoo）。
#   auto = 鍵が入っているもの全部
DISCOVERY_PROVIDERS=auto

# --- Yahoo!ショッピング商品検索 ---------------------------------
#   ★2026-08-20 役割変更：ここは「仕入先」ではありません。
#     日本で何が売れているか・国内の相場はいくらか・JANコードは何かを見るための
#     「市場調査／価格比較」用です。ここで見た価格を仕入値として扱うことはありません。
#   ★重要：既定の利用条件は「非商用」です。商用利用は問い合わせが必要と明記されています。
#     そのため、下の ACK を true にしない限りシステムは絶対にこの探索先を使いません。
YAHOO_SHOPPING_APPID=
YAHOO_SHOPPING_COMMERCIAL_ACK=false

# --- ★無限探索の禁止（1回の実行で使ってよい上限）---------------
# 仕入先から取ってくる商品の上限
MAX_DISCOVERY_ITEMS=100
# 横に広げる深さの上限（0 = 広げない）
MAX_DISCOVERY_DEPTH=1
# そのうち実際にAmazon照合（＝Keepaを消費）する上限
#   ★ここが「500件全部にKeepaを使わない」の本体。まず無料ルールで減らしてから使う
MAX_AMAZON_CHECKS=20
# 有望な1件から周辺へ広げる上限
MAX_EXPAND_PER_SEED=10

# --- ★Amazon→仕入先（本命の向き）の「種」選び -------------------
#   Keepaで「本当に売れている」と確認できた商品だけを種にして、その仕入先を探します。
#   条件に合わなかった商品は、理由コードつきで全部残ります（0件の理由が必ず分かる）。
# 1回の実行で何商品ぶん仕入先を探すか
MAX_REVERSE_SEEDS=20
# 推定月販がこれ未満なら種にしない（月販が「不明」の商品も種にしません）
REVERSE_SEED_MIN_MONTHLY_SALES=10
# 出品者がこれより多ければ種にしない
REVERSE_SEED_MAX_SELLERS=15
# 30日平均と90日平均の差がこの%を超えたら「価格が不安定」として種にしない
REVERSE_SEED_MAX_PRICE_SWING_PCT=20
# 公式の画像検索を使うか（有料APIを無駄打ちしないための栓）
DISCOVERY_USE_IMAGE_SEARCH=true
# 「利益商品1件あたりのAPI費用」を比べてよいだけの実績数（これ未満は結論を出さない）
DISCOVERY_COST_MIN_WINNERS=5

# --- 無料の一次除外（AIもKeepaも使わずにここで落とす）----------
# キャラクター・有名ブランド名を含む商品を落とす
DISCOVERY_BLOCK_IP_RISK=true
# 電波法・PSE・食品・化粧品など、認証が要る商品を落とす
DISCOVERY_BLOCK_REGULATION=true

# モード別の仕入単価上限（円）
DISCOVERY_HIGH_MARGIN_MAX_JPY=800
DISCOVERY_SMALL_LIGHT_MAX_JPY=1200

# 関税率が分からない時に使う既定値（3%）。分かる商品は個別の値が優先される
DEFAULT_DUTY_RATE=0.03

# --- Amazon側の検索（AmazonSearchProvider）---------------------
# auto | keepa | paapi | sample | mock
# keepa = 上の KEEPA_API_KEY があれば本データ。無ければサンプル市場のまま
AMAZON_SEARCH_PROVIDER=auto

# --- MATCH SCORE（同一商品かの判定ライン）----------------------
# これ以上＝高確率で同一（自動で通す）
MATCH_SCORE_AUTO=90
# これ以上＝人が目で確認。これ未満は原則除外
MATCH_SCORE_REVIEW=80

# --- リサーチの条件 --------------------------------------------
# 推定月販がこれ未満の商品は捨てる（管理画面から 10/20/30/50/100/300 に変更可）
RESEARCH_MIN_MONTHLY_SALES=10
# 1件の仕入商品につき、Amazon側の候補を何件まで照合するか
RESEARCH_AMAZON_CANDIDATES=5
# 類似商品からの芋づる探索（0=しない。無限ループ防止のため最大3）
RESEARCH_EXPAND_DEPTH=1
RESEARCH_EXPAND_LIMIT=40
# 需要が大きいのにレビュー不満が多い商品を「OEM候補」に入れる月販ライン
OEM_MIN_MONTHLY_SALES=100

# --- AI費用の上限（★一次判定は必ず料金ゼロ）-------------------
# 1回のリサーチで有料AIを呼んでよい最大回数。0 にすると完全無料運用になる
RESEARCH_MAX_VISION_CALLS=20
RESEARCH_MAX_EMBEDDING_CALLS=200
# 意味の近さ判定: auto | openai | mock（鍵が無ければ自動でmock）
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 画像の最終確認: auto | openai | mock（鍵が無ければ「分からない」を返す）
VISION_PROVIDER=auto
OPENAI_VISION_MODEL=gpt-4o-mini

# --- 通知（NotificationProvider）-------------------------------
# auto | db | line | slack   （db = 画面に出すだけ。既定）
NOTIFY_PROVIDER=auto
LINE_NOTIFY_TOKEN=
SLACK_WEBHOOK_URL=

# ================================================================
#  第4段階：本番運用の安全設定
# ================================================================

# --- ★いきなり大量にAPIを叩かないための安全弁 ------------------
# true の間は、1回のリサーチで扱う商品数を下の上限まで強制的に絞る。
# 本番の鍵を入れた直後は必ず true のままにすること。
LIVE_TEST_MODE=true
# 20 で結果を確認 → 50 → 100 と、人が手でこの数字を上げていく。
# AIがこの数字を勝手に上げることはない。
LIVE_TEST_LIMIT=20

# --- ★初めて扱う商品の仕入数を減らす係数 -----------------------
# 0.5 なら「推奨30個」でも初回は15個しか勧めない。
# 実績が良ければ 15 → 30 → 50 と人が段階的に増やす。
NEW_PRODUCT_SAFETY_FACTOR=0.5

# --- ★自動再発注（既定 false のまま変えない）-------------------
# true にしても、コード側に発注を実行する経路は存在しない。
AUTO_REORDER=false

# --- バックアップ（一番価値が高いのは自社の販売実績）-----------
# 保存先。空なら プロジェクト内の backups/ に保存する
BACKUP_DIR=
# 何世代残すか（古いものから自動で消える。消えるのは写しだけ）
BACKUP_KEEP=30
# 何時間ごとに取るか
BACKUP_INTERVAL_HOURS=24
