# AI GACHA OS ‐ 環境変数の見本
# このファイルをコピーして .env.local を作り、必要なものだけ埋めてください。
# .env.local は git に含まれません。すべて任意です（未設定でもサイトは動きます）。

# ═════════════════════════════════════════════════
# 公開に必須の4項目（これが空だと本番ビルドが失敗します）
#   ① CONTACT_WEBHOOK_URL      問い合わせの通知先
#   ② NEXT_PUBLIC_GA4_ID       アクセス解析
#   ③ NEXT_PUBLIC_CLARITY_ID   録画・ヒートマップ
#   ④ NEXT_PUBLIC_SITE_URL     本番ドメイン
#
# ★設定しただけでは完了になりません。
#   実際に届いたか・実際に計測されたかまで /launch の画面で確認してください
#   （IMPLEMENTED / CONNECTED / E2E VERIFIED の3段階）。
#   手順は docs/本番接続手順.md にあります。
# ═════════════════════════════════════════════════

# ───────── ④ 本番ドメイン ─────────
# 公開する独自ドメイン。末尾のスラッシュは付けません。例 https://gacha-os.jp
# localhost / *.vercel.app / staging. / preview. のURLは本番URLとして使えません。
# canonical・OGP・sitemap・robots・構造化データは、すべてここを見ています。
NEXT_PUBLIC_SITE_URL=

# ───────── 事業者情報（個人情報の取り扱いに必要） ─────────
# お名前・メールをお預かりするため、誰が預かり、どこへ連絡すればよいかの明示が必要です。
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_CONTACT=

# ───────── /launch（公開前チェック画面）の合言葉 ─────────
# 設定すると ?key=（合言葉）付きのURL以外では開けなくなります。
# 未設定でも検索には出ませんが、URLを知っていれば誰でも開ける状態になります。
LAUNCH_KEY=

# ───────── /admin/lp-content（文章の編集画面）の合言葉 ─────────
# サイトの文章と改行を、コードを触らずに直すための画面です。
# 設定すると ?key=（合言葉）付きのURL以外では開けず、保存もできません。
# ★本番でこれが空のときは、画面が開いても「使えません」と表示され、保存は拒否されます。
#   （画面を隠すだけでは守りになりません。保存する側でも同じ判定をしています）
ADMIN_KEY=

# 文章を「公開する」を押したあと、サイトを自動で作り直したい場合に設定します。
# Vercel などの「デプロイフック」のURLを入れてください。
# 未設定でも保存はできます。その場合は次に手動でサイトを作り直したときに反映されます。
DEPLOY_HOOK_URL=

# ───────── ① 問い合わせの受け取り先 ─────────
# 問い合わせ内容の送信先URL（Slack / Googleフォーム連携 / 自社CRM など）。
# 本番でこれが空だと、フォームは「いま受け付けできません」と正直に返します。
# まずは普段確実に確認するメールアドレス1つに届けば十分です。
CONTACT_WEBHOOK_URL=

# ───────── ステップメール（既定＝無効） ─────────
# ここを設定すると「新しい問い合わせが1件入った」という事実だけを配信サービスへ渡します。
# このサイト自身はメールを1通も送りません。文面と送信タイミングは配信サービス側で管理します。
MAIL_SYNC_URL=
MAIL_SYNC_TOKEN=
# 配信サービス側のシナリオ名（メール1=御礼 / メール2=できること / メール3=実還元率デモ）
MAIL_SYNC_SEQUENCE=gacha-os-inbound

# ───────── ②③ アクセス解析（設定するまで計測コードは1行も出ません） ─────────
# ② GA4 の測定ID（G- から始まる）
NEXT_PUBLIC_GA4_ID=
# ③ Microsoft Clarity のプロジェクトID
NEXT_PUBLIC_CLARITY_ID=
# Search Console の所有権確認コード
NEXT_PUBLIC_GSC_VERIFICATION=

# ───────── Heroコピーの出し分け（A/Bテスト） ─────────
# A = オンラインガチャ運営を、仕入れ以外ほぼ自動化。（既定）
# B = ガチャ運営に、人を増やす必要はありません。
# C = ガチャ作成から発送まで。AIが運営を支える。
# D = 利益を守りながら、ガチャ運営を自動化。
NEXT_PUBLIC_HERO_VARIANT=A

# ───────── 料金の見せ方 ─────────
# current = いまの3段階表示（既定）
# tiers   = STARTER / GROWTH / ENTERPRISE の3プラン表示
# ※ tiers の金額は「個別お見積り」のままです。実価格は content/site.ts で確定させてください。
NEXT_PUBLIC_PRICING_MODE=current
