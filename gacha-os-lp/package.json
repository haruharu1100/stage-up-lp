    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/run-tests.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:reach": "node scripts/check-admin-reach.mjs",
    "check:ux": "node scripts/check-admin-ux.mjs",
    "check:flash": "node scripts/check-flash.mjs",
    "check:draw": "node scripts/check-draw-rng.mjs",
    "check:regression": "node scripts/check-regression.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "verify": "npm run check:draw && tsc --noEmit && npm test && npm run check:urls && npm run build",
    "seed:preview": "tsx scripts/seed-preview.mjs"
