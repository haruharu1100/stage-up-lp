# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本番確認用のビルド出力
#
# ★新しく作るときは、名前を「.next」で始めないこと。
#   Vercel は「.next」で始まる名前を自分の作業場所として特別に扱うので、
#   .vercelignore に書いても公開のときに外れず、216MB を送ろうとして
#   途中で止まります（2026-08-24 実測）。理由は .vercelignore に書いてあります。
.next-prod/
.next-verify/
_next-verify-local/

# 検証用のスクリーンショット・録画（容量が大きいのでgitに入れない）
/_verify/

# 検証用スクリーンショット（毎回作り直すので残さない）
/public/shots/

# 保存先（手元で動かすときのデータベース本体）
#
# ★絶対に git に入れないこと。
#   中には、お客様の残高・抽選の結果・監査ログが入ります。
#   一度入れてしまうと、あとから消しても履歴には残り続けます。
#   本番の保存先は、DATABASE_URL で外から渡します。
/.data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 秘密が入るファイル
#
# ★.env は、上の階層の .gitignore でも外していますが、
#   ここにも書いておきます。
#   上の設定が変わったときに、ここだけが最後の砦になります。
#   「二重に書いてあるから消す」は絶対にしないこと。
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# 記録（中に個人情報や鍵が写り込みます）
*.log
logs/

# 一時ファイル
*.tmp
*.temp
.tmp/
tmp/
.DS_Store
.env*

# 鍵の受け渡し場所（絶対に git へ入れないこと）
#
#   認証アプリの鍵は、ここにしか書きません。
#   scripts/rotate-mfa-preview.mjs が、ここへ書き出します。
#   登録が終わったら、中のファイルは削除してください。
#
# ★この行を消さないこと。消すと、鍵がそのまま git に入ります。
.secrets/
