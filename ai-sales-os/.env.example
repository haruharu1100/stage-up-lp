# AI営業・案件自動受注OS — 環境変数の見本
# 値は書かない。実際の値は .env に入れる（.env はGit管理外）。

# ---------------------------------------------------------------- 保存先
# 手元のパソコンで動かすとき：ファイルに保存する。
DATABASE_URL=file:data/sales.db
# インターネット上のサイトとして動かすとき：クラウドのデータベースを指す。
#   例）DATABASE_URL=libsql://xxxxx.turso.io
#   ★ファイル保存のままサーバーに置くと、書いたものが消える。必ず差し替える。
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------- 入口の鍵（サイトとして公開するとき必須）
# この2つが空だと、公開したサイトは誰も開けない（誤って全公開する事故を防ぐため）。
# 手元のパソコン（npm run dev）では鍵は掛からない。
SITE_USER=
SITE_PASSWORD=

# ---------------------------------------------------------------- Obsidian（正本）
# 事業Vaultの場所。ここを正本として商品カタログ・能力カタログを読み込む。
OBSIDIAN_VAULT_DIR=/Volumes/ORICO/保存用/hp用/hp-auto-system/事業Vault
OBSIDIAN_MEMORY_DIR=/Users/yokotaakiraju/Documents/Obsidian Vault/_AI/memory

# ---------------------------------------------------------------- AI
# AI_ENABLED=false の間は、ルールベースの解析器で動く（課金ゼロ・結果は再現可能）。
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- 法人データ取得（読み取りのみ）
# 国税庁 法人番号システム Web-API のアプリケーションID
HOUJIN_BANGOU_APP_ID=
# gBizINFO のAPIトークン
GBIZINFO_API_TOKEN=
# Google Places API（正規API。スクレイピングはしない）
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------- 営業メールに法律上必ず入れる4項目
# 特定電子メール法。1つでも空だとメールの下書きを作らない（BLOCKEDになる）。
SENDER_NAME=
SENDER_ADDRESS=
SENDER_EMAIL=
SENDER_UNSUBSCRIBE_URL=

# ---------------------------------------------------------------- 安全スイッチ（全部 false が初期値）
# ここを true にしても、実行する処理コード自体を置いていないため外部送信は起きない。
# 実装する時は必ず「段階解放」の手順を踏む。
AUTO_CALL=false
AUTO_EMAIL=false
AUTO_FORM=false
AUTO_APPLY=false
AUTO_DELIVER=false

# 調査・解析・文章生成・スコアリング・案件発見は自動で動いてよい
AUTO_RESEARCH=true

# 段階解放フェーズ（1〜5）。1は収集・分析のみ。
RELEASE_PHASE=1
